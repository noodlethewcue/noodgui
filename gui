    shadow.TextColor3 = Color3.fromRGB(80,40,60)
    shadow.TextXAlignment = Enum.TextXAlignment.Center

    local real = shadow:Clone()
    real.Name = "RealText"
    real.Parent = parent
    real.Position = UDim2.new(0,0,0,0)
