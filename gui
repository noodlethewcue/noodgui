    corner.Parent = popup

    -- Fade out
    task.delay(2.5, function()

        if popup and popup.Parent then

            local tween = TweenService:Create(
                popup,
                TweenInfo.new(
                    0.5,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
