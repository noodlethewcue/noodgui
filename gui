-- APPLY NAME
--==================================================

local function applyCustomName()

    local label = getPlayerNameLabel()

    if not label then
        warn("PlayerName label not found!")
        return
    end

    -- Save original text only once
    if originalPlayerName == nil then
        originalPlayerName = label.Text
    end

    local typedName = NameBox.Text

    if typedName == "" then
        return
    end

    currentCustomName = "(@" .. typedName .. ")"

    stopNameOverride()

    nameConnection = game:GetService("RunService").RenderStepped:Connect(
        function()

            if label
                and label.Parent
                and currentCustomName then

                if label.Text ~= currentCustomName then
                    label.Text = currentCustomName
                end

            end

        end
    )

end

--==================================================
-- RESET NAME
--==================================================

local function resetCustomName()

    currentCustomName = nil

    stopNameOverride()

    local label = getPlayerNameLabel()

    if label and originalPlayerName then
        label.Text = originalPlayerName
    end

    originalPlayerName = nil

end

