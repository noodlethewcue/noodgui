local function getPlayerNameLabel()
    local billboards = workspace:FindFirstChild("Billboards")
    if not billboards then
        return nil
    end

    -- Change this path if your game's Billboards folder
    -- uses a different folder name for the local player.
    local playerFolder = billboards:FindFirstChild(
        game.Players.LocalPlayer.Name
    )

    if not playerFolder then
        return nil
    end

    local content = playerFolder:FindFirstChild("Content")
    if not content then return nil end

    local mainContainer = content:FindFirstChild("MainContainer")
    if not mainContainer then return nil end

    local playerNameContainer =
        mainContainer:FindFirstChild("PlayerNameContainer")

    if not playerNameContainer then
        return nil
    end

    return playerNameContainer:FindFirstChild("PlayerName")
end

--==================================================
-- STOP OVERRIDE
--==================================================

local function stopNameOverride()

    if nameConnection then
        nameConnection:Disconnect()
        nameConnection = nil
    end

end

--==================================================
-- APPLY NAME
--==================================================

local function applyCustomName()

    local label = getPlayerNameLabel()

    if not label then
        warn("PlayerName label not found!")
        return
    end

    -- Save original text only once
    if originalPlayerName == nil then
        originalPlayerName = label.Text
    end

    local typedName = NameBox.Text

    if typedName == "" then
        return
    end

    currentCustomName = "(@" .. typedName .. ")"

    stopNameOverride()

    nameConnection = game:GetService("RunService").RenderStepped:Connect(
        function()

            if label
                and label.Parent
                and currentCustomName then

                if label.Text ~= currentCustomName then
                    label.Text = currentCustomName
                end

            end

        end
    )

end

--==================================================
-- RESET NAME
--==================================================

local function resetCustomName()

    currentCustomName = nil

    stopNameOverride()

    local label = getPlayerNameLabel()

    if label and originalPlayerName then
        label.Text = originalPlayerName
    end

    originalPlayerName = nil

end

