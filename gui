local slitOriginal = {}

createButton("clients", "slit eyes", function(enabled)

    local character = player.Character
    if not character then return end

    local pupilNames = {
        leftpupil = true,
        leftpupilblind = true,
        rightpupil = true,
        rightpupilblind = true
    }

    if enabled then

        -- Find EVERY pupil
        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") and pupilNames[obj.Name:lower()] then

                -- Only save it once
                if not slitOriginal[obj] then
                    slitOriginal[obj] = {
                        Size = obj.Size
                    }
                end

                -- Make it narrow horizontally
                local originalSize = slitOriginal[obj].Size

                obj.Size = Vector3.new(
                    originalSize.X * 0.45,
                    originalSize.Y,
                    originalSize.Z
                )
            end
        end

    else

        -- Restore EVERY pupil
        for obj, original in pairs(slitOriginal) do
            if obj and obj.Parent then
                obj.Size = original.Size
            end
        end

        table.clear(slitOriginal)
    end
end)

