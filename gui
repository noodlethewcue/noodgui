-- AGGRESSIVE POSE
local aggressiveOriginals = {}
local aggressivePupilOriginals = {}

createButton("clients", "aggressive", function(enabled)

    local character = player.Character or player.CharacterAdded:Wait()

    local leftEar
    local rightEar
    local neck

    local tailJoints = {}
    local mouthJoints = {}

    -- Find joints
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Motor6D") then

            local name = obj.Name:lower()

            if name:find("lear") then
                leftEar = obj

            elseif name:find("rear") then
                rightEar = obj

            elseif name:find("neck") then
                neck = obj

            elseif name:find("tail") then
                table.insert(tailJoints, obj)

            elseif name:find("jaw") or name:find("mouth") then
                table.insert(mouthJoints, obj)
            end
        end
    end

    -- ==========================================
    -- ENABLE
    -- ==========================================

    if enabled then

        -- Save original joint positions
        local joints = {
            leftEar,
            rightEar,
            neck
        }

        for _, joint in ipairs(tailJoints) do
            table.insert(joints, joint)
        end

        for _, joint in ipairs(mouthJoints) do
            table.insert(joints, joint)
        end

        for _, joint in ipairs(joints) do
            if joint and not aggressiveOriginals[joint] then
                aggressiveOriginals[joint] = joint.C0
            end
        end

        -- Pinned ears
        if leftEar then
            leftEar.C0 =
                aggressiveOriginals[leftEar]
                * CFrame.Angles(0, 0, math.rad(45))
        end

        if rightEar then
            rightEar.C0 =
                aggressiveOriginals[rightEar]
                * CFrame.Angles(0, 0, math.rad(-45))
        end

        -- Head / neck down
        if neck then
            neck.C0 =
                aggressiveOriginals[neck]
                * CFrame.Angles(math.rad(-15), 0, 0)
        end

        -- Super wide jaw
        for _, joint in ipairs(mouthJoints) do
            joint.C0 =
                aggressiveOriginals[joint]
                * CFrame.Angles(math.rad(-55), 0, 0)
        end

        -- Aggressive tail
        for _, joint in ipairs(tailJoints) do
            joint.C0 =
                aggressiveOriginals[joint]
                * CFrame.Angles(
                    math.rad(-12),
                    math.rad(18),
                    0
                )
        end

        -- ==========================================
        -- SLIT PUPILS
        -- ==========================================

        local pupilNames = {
            leftpupil = true,
            leftpupilblind = true,
            rightpupil = true,
            rightpupilblind = true
        }

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart")
            and pupilNames[obj.Name:lower()] then

                if not aggressivePupilOriginals[obj] then
                    aggressivePupilOriginals[obj] = obj.Size
                end

                local originalSize =
                    aggressivePupilOriginals[obj]

                obj.Size = Vector3.new(
                    originalSize.X * 0.45,
                    originalSize.Y,
                    originalSize.Z
                )
            end
        end

    -- ==========================================
    -- DISABLE / RESTORE
    -- ==========================================

    else

        -- Restore joints
        for joint, originalC0 in pairs(aggressiveOriginals) do
            if joint and joint.Parent then
                joint.C0 = originalC0
            end
        end

        -- Restore pupils
        for pupil, originalSize in pairs(aggressivePupilOriginals) do
            if pupil and pupil.Parent then
                pupil.Size = originalSize
            end
        end

        table.clear(aggressiveOriginals)
        table.clear(aggressivePupilOriginals)
    end
end)

