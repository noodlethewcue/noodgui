            if object:IsA("BasePart")
                and object.Transparency == 0 then

                local c = object.Color

                local r = math.round(c.R * 255)
                local g = math.round(c.G * 255)
                local b = math.round(c.B * 255)

                table.insert(
                    lines,
                    object.Name ..
                    "|" ..
                    r ..
                    "," ..
                    g ..
                    "," ..
                    b
                )
            end
        end

        table.sort(lines)

        local code = table.concat(lines, "\n")

