createButton("clients", "spawn npc", function(enabled)

	-- ==========================================
	-- CLEANUP OLD NPC
	-- ==========================================

	if _G.BlackWanderingCatCleanup then
		_G.BlackWanderingCatCleanup()
		_G.BlackWanderingCatCleanup = nil
	end

	if not enabled then
		return
	end

	-- ==========================================
	-- SERVICES
	-- ==========================================

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")

	local player = Players.LocalPlayer
	local character = player.Character or player.CharacterAdded:Wait()

	-- ==========================================
	-- SETTINGS
	-- ==========================================

	local MAX_DISTANCE = 200
	local EFFECT_DISTANCE = 10
	local MAX_HEAD_ANGLE = math.rad(90)

	local SPEEDS = {
		Walk = 5.5,
		Trot = 8,
		Canter = 12,
		Sprint = 17
	}

	local ANIMATIONS = {
		Walk = "rbxassetid://6590492612",
		Idle = "rbxassetid://6590483615",
		Trot = "rbxassetid://6590492234",
		Canter = "rbxassetid://6590481784",
		Sprint = "rbxassetid://6590486696"
	}

	local EYE_NAMES = {
		leftsclera = true,
		leftblind = true,
		leftpupil = true,
		leftpupilblind = true,
		rightsclera = true,
		rightblind = true,
		rightpupil = true,
		rightpupilblind = true
	}

	-- ==========================================
	-- CLONE
	-- ==========================================

	local npc = character:Clone()
	npc.Name = "BlackWanderingCat"

	for _, obj in ipairs(npc:GetDescendants()) do
		if obj:IsA("Script")
		or obj:IsA("LocalScript")
		or obj:IsA("ModuleScript") then
			obj:Destroy()
		end
	end

	npc.Parent = workspace

	local root = npc:FindFirstChild("HumanoidRootPart")

	if not root then
		npc:Destroy()
		return
	end

	local spawnPosition = root.Position

	-- ==========================================
	-- BLACK BODY + WHITE EYES
	-- ==========================================

	for _, obj in ipairs(npc:GetDescendants()) do

		if obj:IsA("BasePart") then

			if EYE_NAMES[obj.Name:lower()] then
				obj.Color = Color3.new(1, 1, 1)
				obj.Material = Enum.Material.Neon
			else
				obj.Color = Color3.new(0, 0, 0)
				obj.Material = Enum.Material.SmoothPlastic
			end
		end
	end

	-- ==========================================
	-- DARK AURA
	-- ==========================================

	local auraAttachment = Instance.new("Attachment")
	auraAttachment.Name = "DarkAura"
	auraAttachment.Parent = root

	local aura = Instance.new("ParticleEmitter")
	aura.Name = "ShadowParticles"
	aura.Parent = auraAttachment

	aura.Color = ColorSequence.new(Color3.new(0, 0, 0))
	aura.LightEmission = 0
	aura.Brightness = 0

	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.3, 0.35),
		NumberSequenceKeypoint.new(0.7, 0.55),
		NumberSequenceKeypoint.new(1, 0)
	})

	aura.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.1, 0.2),
		NumberSequenceKeypoint.new(0.7, 0.5),
		NumberSequenceKeypoint.new(1, 1)
	})

	aura.Lifetime = NumberRange.new(0.8, 2.8)
	aura.Rate = 35
	aura.Speed = NumberRange.new(0.2, 1.8)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Rotation = NumberRange.new(0, 360)
	aura.RotSpeed = NumberRange.new(-100, 100)
	aura.Acceleration = Vector3.new(0, 1.5, 0)
	aura.Drag = 3
	aura.Shape = Enum.ParticleEmitterShape.Sphere
	aura.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	aura.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward

	-- ==========================================
	-- CREEPY PARTICLES
	-- ==========================================

	local creepyAttachment = Instance.new("Attachment")
	creepyAttachment.Name = "CreepyParticles"
	creepyAttachment.Position = Vector3.new(0, 1.5, 0)
	creepyAttachment.Parent = root

	local creepy = Instance.new("ParticleEmitter")
	creepy.Name = "FloatingShadows"
	creepy.Parent = creepyAttachment

	creepy.Color = ColorSequence.new(Color3.new(0, 0, 0))
	creepy.LightEmission = 0

	creepy.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.5, 0.7),
		NumberSequenceKeypoint.new(1, 0)
	})

	creepy.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, 0.15),
		NumberSequenceKeypoint.new(0.8, 0.5),
		NumberSequenceKeypoint.new(1, 1)
	})

	creepy.Lifetime = NumberRange.new(1.5, 3.5)
	creepy.Rate = 12
	creepy.Speed = NumberRange.new(0.5, 2)
	creepy.SpreadAngle = Vector2.new(360, 360)
	creepy.Rotation = NumberRange.new(0, 360)
	creepy.RotSpeed = NumberRange.new(-180, 180)
	creepy.Acceleration = Vector3.new(0, 2.5, 0)
	creepy.Drag = 2
	creepy.Shape = Enum.ParticleEmitterShape.Sphere
	creepy.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume

	-- ==========================================
	-- HUMANOID
	-- ==========================================

	local humanoid = npc:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		npc:Destroy()
		return
	end

	humanoid.AutoRotate = true

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	-- ==========================================
	-- ANIMATIONS
	-- ==========================================

	local tracks = {}

	for name, id in pairs(ANIMATIONS) do

		local animation = Instance.new("Animation")
		animation.AnimationId = id

		local track

		pcall(function()
			track = animator:LoadAnimation(animation)
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Movement
		end)

		if track then
			tracks[name] = track
		end
	end

	if tracks.Idle then
		tracks.Idle.Priority = Enum.AnimationPriority.Idle
	end

	local currentTrack

	local function playMovement(gait)

		if currentTrack == tracks[gait] then
			return
		end

		if currentTrack then
			currentTrack:Stop(0.15)
		end

		currentTrack = tracks[gait]

		if currentTrack then
			currentTrack:Play(0.15)
		end

		humanoid.WalkSpeed = SPEEDS[gait]
	end

	local function playIdle()

		if currentTrack == tracks.Idle then
			return
		end

		if currentTrack then
			currentTrack:Stop(0.15)
		end

		currentTrack = tracks.Idle

		if currentTrack then
			currentTrack:Play(0.15)
		end

		humanoid.WalkSpeed = 0
	end

	-- ==========================================
	-- RANDOM POSITION
	-- ==========================================

	local function getRandomPoint()

		local angle = math.random() * math.pi * 2
		local distance =
			math.sqrt(math.random()) *
			(MAX_DISTANCE - 15)

		local target =
			spawnPosition +
			Vector3.new(
				math.cos(angle) * distance,
				0,
				math.sin(angle) * distance
			)

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {npc}

		local result = workspace:Raycast(
			target + Vector3.new(0, 100, 0),
			Vector3.new(0, -250, 0),
			params
		)

		if result then
			return result.Position +
				Vector3.new(0, 3, 0)
		end

		return target
	end

	local function chooseGait()

		local roll = math.random(1, 100)

		if roll <= 68 then
			return "Walk"
		elseif roll <= 88 then
			return "Trot"
		elseif roll <= 97 then
			return "Canter"
		else
			return "Sprint"
		end
	end

	-- ==========================================
	-- FADE SYSTEM
	-- ==========================================

	local fadeCancelled = false

	local function fadeIn()

		local parts = {}

		for _, obj in ipairs(npc:GetDescendants()) do
			if obj:IsA("BasePart") then
				table.insert(parts, {
					part = obj,
					original = obj.Transparency
				})
				obj.Transparency = 1
			end
		end

		local start = os.clock()
		local duration = 1

		while os.clock() - start < duration
			and npc.Parent
			and not fadeCancelled do

			local alpha =
				math.clamp(
					(os.clock() - start) / duration,
					0,
					1
				)

			for _, data in ipairs(parts) do
				if data.part.Parent then
					data.part.Transparency =
						1 - ((1 - data.original) * alpha)
				end
			end

			RunService.RenderStepped:Wait()
		end

		if not fadeCancelled then
			for _, data in ipairs(parts) do
				if data.part.Parent then
					data.part.Transparency = data.original
				end
			end
		end
	end

	local function fadeOutAndDestroy()

		fadeCancelled = true

		local parts = {}

		for _, obj in ipairs(npc:GetDescendants()) do
			if obj:IsA("BasePart") then
				table.insert(parts, {
					part = obj,
					original = obj.Transparency
				})
			end
		end

		local start = os.clock()
		local duration = 0.8

		while os.clock() - start < duration
			and npc.Parent do

			local alpha =
				math.clamp(
					(os.clock() - start) / duration,
					0,
					1
				)

			for _, data in ipairs(parts) do
				if data.part.Parent then
					data.part.Transparency =
						data.original +
						(1 - data.original) * alpha
				end
			end

			RunService.RenderStepped:Wait()
		end

		if npc.Parent then
			npc:Destroy()
		end
	end

	-- ==========================================
	-- NECK
	-- ==========================================

	local neck
	local neckOriginalC0
	local currentNeckC0

	for _, obj in ipairs(npc:GetDescendants()) do

		if obj:IsA("Motor6D")
		and obj.Name:lower():find("neck") then

			neck = obj
			neckOriginalC0 = obj.C0
			currentNeckC0 = obj.C0
			break
		end
	end

	local function getHeadTarget()

		local targetCharacter = player.Character

		if not targetCharacter then
			return nil
		end

		local targetRoot =
			targetCharacter:FindFirstChild(
				"HumanoidRootPart"
			)

		if not targetRoot then
			return nil
		end

		local offset =
			targetRoot.Position - root.Position

		if offset.Magnitude > EFFECT_DISTANCE then
			return nil
		end

		local flatOffset =
			Vector3.new(
				offset.X,
				0,
				offset.Z
			)

		if flatOffset.Magnitude < 0.01 then
			return targetRoot.Position
		end

		local direction = flatOffset.Unit

		local forward =
			Vector3.new(
				root.CFrame.LookVector.X,
				0,
				root.CFrame.LookVector.Z
			)

		if forward.Magnitude < 0.01 then
			return nil
		end

		forward = forward.Unit

		local dot =
			math.clamp(
				forward:Dot(direction),
				-1,
				1
			)

		local angle = math.acos(dot)

		-- 90° LEFT + 90° RIGHT.
		if angle > MAX_HEAD_ANGLE then
			return nil
		end

		-- ======================================
		-- LINE OF SIGHT
		-- ======================================

		local params = RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Exclude

		params.FilterDescendantsInstances = {
			npc,
			targetCharacter
		}

		local origin =
			root.Position +
			Vector3.new(0, 2, 0)

		local rayDirection =
			targetRoot.Position - origin

		local result =
			workspace:Raycast(
				origin,
				rayDirection,
				params
			)

		if result then
			return nil
		end

		return targetRoot.Position
	end

	local function updateNeck(dt)

		if not neck
		or not neck.Parent
		or not neckOriginalC0
		or not currentNeckC0 then
			return
		end

		local target = getHeadTarget()

		local wantedC0 =
			neckOriginalC0

		if target then

			local localTarget =
				root.CFrame:PointToObjectSpace(target)

			local yaw =
				math.atan2(
					-localTarget.X,
					-localTarget.Z
				)

			local horizontalDistance =
				Vector2.new(
					localTarget.X,
					localTarget.Z
				).Magnitude

			local pitch =
				math.atan2(
					localTarget.Y,
					math.max(
						horizontalDistance,
						0.01
					)
				)

			-- EXACTLY 90° EACH SIDE.
			yaw =
				math.clamp(
					yaw,
					-math.rad(90),
					math.rad(90)
				)

			pitch =
				math.clamp(
					pitch,
					math.rad(-45),
					math.rad(45)
				)

			wantedC0 =
				neckOriginalC0 *
				CFrame.Angles(
					-pitch,
					yaw,
					0
				)
		end

		-- Smooth tracking and smooth return.
		local alpha =
			1 - math.exp(-6 * dt)

		currentNeckC0 =
			currentNeckC0:Lerp(
				wantedC0,
				alpha
			)

		neck.C0 = currentNeckC0
	end

	-- ==========================================
	-- HORROR EFFECT
	-- ==========================================

	local camera = workspace.CurrentCamera

	local horrorGui =
		Instance.new("ScreenGui")

	horrorGui.Name =
		"BlackCatHorror"

	horrorGui.IgnoreGuiInset = true
	horrorGui.ResetOnSpawn = false
	horrorGui.DisplayOrder = 999
	horrorGui.Parent =
		player:WaitForChild("PlayerGui")

	local darkness =
		Instance.new("Frame")

	darkness.Name = "Darkness"
	darkness.Size =
		UDim2.fromScale(1, 1)

	darkness.BackgroundColor3 =
		Color3.new(0, 0, 0)

	darkness.BackgroundTransparency = 1
	darkness.BorderSizePixel = 0
	darkness.ZIndex = 1
	darkness.Parent = horrorGui

	local colorCorrection =
		Instance.new("ColorCorrectionEffect")

	colorCorrection.Name =
		"BlackCatHorrorColor"

	colorCorrection.Saturation = 0
	colorCorrection.Contrast = 0
	colorCorrection.Brightness = 0
	colorCorrection.Parent = Lighting

	local blur =
		Instance.new("BlurEffect")

	blur.Name =
		"BlackCatHorrorBlur"

	blur.Size = 0
	blur.Parent = Lighting

	-- ==========================================
	-- CONNECTIONS
	-- ==========================================

	local connections = {}
	local destroyed = false

	local function cleanup()

		if destroyed then
			return
		end

		destroyed = true

		for _, connection in ipairs(connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end

		if horrorGui then
			horrorGui:Destroy()
		end

		if colorCorrection then
			colorCorrection:Destroy()
		end

		if blur then
			blur:Destroy()
		end

		for _, track in pairs(tracks) do
			pcall(function()
				track:Stop()
			end)
		end

		if npc and npc.Parent then
			task.spawn(fadeOutAndDestroy)
		end
	end

	_G.BlackWanderingCatCleanup = cleanup

	-- ==========================================
	-- WANDERING
	-- ==========================================

	task.spawn(function()

		playIdle()

		while npc.Parent
		and humanoid.Health > 0
		and not destroyed do

			task.wait(
				math.random(8, 18) / 10
			)

			if destroyed
			or not npc.Parent then
				break
			end

			local gait =
				chooseGait()

			local target =
				getRandomPoint()

			playMovement(gait)
			humanoid:MoveTo(target)

			local duration

			if gait == "Walk" then
				duration = math.random(5, 10)
			elseif gait == "Trot" then
				duration = math.random(3, 7)
			elseif gait == "Canter" then
				duration = math.random(2, 5)
			else
				duration = math.random(1, 3)
			end

			local start = os.clock()

			while os.clock() - start < duration
				and npc.Parent
				and humanoid.Health > 0
				and not destroyed do

				local offset =
					root.Position -
					spawnPosition

				if offset.Magnitude >= MAX_DISTANCE then

					humanoid:MoveTo(
						spawnPosition +
						offset.Unit *
						(MAX_DISTANCE - 25)
					)

					break
				end

				task.wait(0.15)
			end

			humanoid:MoveTo(root.Position)
			playIdle()
		end
	end)

	-- ==========================================
	-- PROXIMITY + CAMERA SHAKE
	-- ==========================================

	table.insert(
		connections,

		RunService.RenderStepped:Connect(function(dt)

			if destroyed
			or not npc.Parent
			or not root.Parent then
				return
			end

			updateNeck(dt)

			local currentCharacter =
				player.Character

			if not currentCharacter then
				return
			end

			local playerRoot =
				currentCharacter:FindFirstChild(
					"HumanoidRootPart"
				)

			if not playerRoot then
				return
			end

			local distance =
				(
					playerRoot.Position -
					root.Position
				).Magnitude

			if distance >= EFFECT_DISTANCE then

				darkness.BackgroundTransparency = 1

				colorCorrection.Saturation = 0
				colorCorrection.Contrast = 0
				colorCorrection.Brightness = 0

				blur.Size = 0

				return
			end

			local intensity =
				math.clamp(
					(EFFECT_DISTANCE - distance)
					/ EFFECT_DISTANCE,
					0,
					1
				)

			local creepy =
				intensity ^ 0.55

			-- VERY DARK.
			darkness.BackgroundTransparency =
				1 - creepy * 0.72

			-- FULL DESATURATION.
			colorCorrection.Saturation =
				-creepy

			colorCorrection.Contrast =
				creepy * 0.7

			colorCorrection.Brightness =
				-creepy * 0.3

			blur.Size =
				creepy * 3.5

			-- ==================================
			-- STRONG SHAKE
			-- ==================================

			local time = os.clock()

			local shake =
				0.18 * creepy

			local x =
				math.sin(time * 15) *
				shake

			local y =
				math.cos(time * 19) *
				shake

			local z =
				math.sin(time * 11) *
				shake * 0.75

			camera.CFrame =
				camera.CFrame *
				CFrame.Angles(
					math.rad(x),
					math.rad(y),
					math.rad(z)
				)

			if math.random() <
				creepy * 0.22 then

				camera.CFrame =
					camera.CFrame *
					CFrame.new(
						(math.random() - 0.5)
							* 0.18
							* creepy,

						(math.random() - 0.5)
							* 0.18
							* creepy,

						0
					)
			end
		end)
	)

	-- ==========================================
	-- FADE IN
	-- ==========================================

	task.spawn(function()
		fadeIn()
	end)

end)

