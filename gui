-- =====================================================
-- CLIENT ANIMATION LOOP
-- =====================================================

RunService.RenderStepped:Connect(function()

	if not char.Parent then
		return
	end

	if not stupidDance1 and not stupidDance2 then
		return
	end

	local t = (os.clock() - danceStart)

	-- =================================================
	-- DANCE 1
	-- =================================================

	if stupidDance1 then

		t = t * 5

		local a = math.sin(t)
		local b = math.sin(t * 2)

		-- BODY
		move("Chest", b * 12, a * 8, math.cos(t) * 10)
		move("MidTorso", -b * 8, -a * 5, -math.cos(t) * 7)
		move("Hip", b * 10, -a * 10, math.cos(t) * 12)

		-- HEAD
		move("Neck",
			math.sin(t * 2) * 12,
			math.sin(t) * 20,
			math.cos(t * 2) * 18
		)

		move("Head",
			math.sin(t * 2) * 8,
			math.cos(t * 1.5) * 12,
			math.sin(t) * 15
		)

		-- FRONT LEFT
		local fl = math.sin(t)

		move("FLW", -fl * 65, 0, fl * 15)
		move("FLP", -fl * 45, 0, fl * 12)
		move("FLL", fl * 35, 0, -fl * 10)
		move("FLS", fl * 45, 0, fl * 8)

		-- FRONT RIGHT
		local fr = math.sin(t + math.pi)

		move("FRW", -fr * 65, 0, fr * 15)
		move("FRP", -fr * 45, 0, fr * 12)
		move("FRL", fr * 35, 0, -fr * 10)
		move("FRS", fr * 45, 0, fr * 8)

		-- BACK LEFT
		local bl = math.sin(t + math.pi / 2)

		move("BLW", -bl * 70, 0, bl * 18)
		move("BLP", -bl * 50, 0, bl * 15)
		move("BLL", bl * 40, 0, -bl * 12)
		move("BLS", bl * 50, 0, bl * 10)

		-- BACK RIGHT
		local br = math.sin(t - math.pi / 2)

		move("BRW", -br * 70, 0, br * 18)
		move("BRP", -br * 50, 0, br * 15)
		move("BRL", br * 40, 0, -br * 12)
		move("BRS", br * 50, 0, br * 10)

		-- TAIL
		for i, joint in ipairs(tails) do
			local wave = math.sin(t * 1.8 - i * 0.55)
			local wave2 = math.cos(t * 1.8 - i * 0.55)

			joint.C0 =
				original[joint] *
				CFrame.Angles(
					math.rad(wave * (8 + i * 4)),
					math.rad(wave2 * (12 + i * 5)),
					math.rad(wave * (15 + i * 5))
				)
		end

		-- JAW
		local jaw = math.abs(math.sin(t * 2.2))

		move("Jaw",
			-jaw * 40,
			math.sin(t * 4) * 10,
			math.cos(t * 2.2) * 6
		)

		move("Mouth",
			-jaw * 25,
			math.sin(t * 2) * 10,
			math.cos(t * 2) * 15
		)

	end

	-- =================================================
	-- DANCE 2
	-- =================================================

	if stupidDance2 then

		t = t * 3.5

		local sway = math.sin(t)

		-- BIG BODY SWING
		move("Chest",
			sway * 18,
			math.sin(t * 2) * 8,
			sway * 22
		)

		move("MidTorso",
			-sway * 12,
			-math.sin(t * 2) * 5,
			-sway * 14
		)

		move("Hip",
			sway * 15,
			-math.sin(t * 2) * 10,
			sway * 18
		)

		-- HEAD
		move("Neck",
			math.sin(t * 1.5) * 15,
			math.sin(t) * 28,
			math.cos(t * 1.5) * 22
		)

		move("Head",
			math.sin(t * 1.5) * 12,
			math.cos(t) * 18,
			math.sin(t) * 25
		)

		-- FRONT LEGS
		local fl = math.sin(t)
		local fr = math.sin(t + math.pi)

		move("FLW", -fl * 80, 0, fl * 25)
		move("FLP", -fl * 55, 0, fl * 20)
		move("FLL", fl * 45, 0, -fl * 18)
		move("FLS", fl * 55, 0, fl * 15)

		move("FRW", -fr * 80, 0, fr * 25)
		move("FRP", -fr * 55, 0, fr * 20)
		move("FRL", fr * 45, 0, -fr * 18)
		move("FRS", fr * 55, 0, fr * 15)

		-- BACK LEGS KICK
		local bl = math.sin(t + math.pi / 2)
		local br = math.sin(t - math.pi / 2)

		move("BLW", -bl * 75, 0, bl * 20)
		move("BLP", -bl * 55, 0, bl * 18)
		move("BLL", bl * 45, 0, -bl * 15)
		move("BLS", bl * 50, 0, bl * 12)

		move("BRW", -br * 75, 0, br * 20)
		move("BRP", -br * 55, 0, br * 18)
		move("BRL", br * 45, 0, -br * 15)
		move("BRS", br * 50, 0, br * 12)

		-- TAIL WHIP
		for i, joint in ipairs(tails) do
			local wave = math.sin(t * 2 - i * 0.7)
			local wave2 = math.cos(t * 2 - i * 0.7)

			joint.C0 =
				original[joint] *
				CFrame.Angles(
					math.rad(wave * (12 + i * 5)),
					math.rad(wave2 * (18 + i * 7)),
					math.rad(wave * (20 + i * 7))
				)
		end

		-- JAW
		local jaw = math.abs(math.sin(t * 2.5))

		move("Jaw",
			-jaw * 48,
			math.sin(t * 5) * 12,
			math.cos(t * 2.5) * 8
		)

		move("Mouth",
			-jaw * 20,
			math.sin(t * 4) * 12,
			math.cos(t * 3) * 12
		)
	end

end)

