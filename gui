local function createGuiSizeButton(btnName)
    tabButtons["settings"] = tabButtons["settings"] or {}

    local holder = Instance.new("Frame")
    holder.Parent = scroll
    holder.Name = "Settings_" .. btnName
    holder.BackgroundColor3 =
        (btnName == "large gui") and BUTTON_CLICK or BUTTON
    holder.BorderSizePixel = 0

    Instance.new("UICorner", holder).CornerRadius = UDim.new(0,16)

    local btn = Instance.new("TextButton")
    btn.Parent = holder
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    createShadowText(holder, btnName, 24)

    btn.MouseButton1Down:Connect(function()
        holder.BackgroundColor3 = BUTTON_CLICK
    end)

    btn.MouseButton1Up:Connect(function()
        if currentGuiSize == btnName then
            holder.BackgroundColor3 = BUTTON_CLICK
        else
            holder.BackgroundColor3 = BUTTON
        end
    end)

    btn.MouseButton1Click:Connect(function()
        currentGuiSize = btnName

        -- Change the GUI size
        main.Size = guiSizes[btnName]

        -- Resize ALL buttons so they fit inside the category
        updateAllButtonSizes()

        -- Highlight selected size
        for name, buttonHolder in pairs(guiSizeButtons) do
            if name == currentGuiSize then
                buttonHolder.BackgroundColor3 = BUTTON_CLICK
            else
                buttonHolder.BackgroundColor3 = BUTTON
            end
        end
    end)

    holder.Visible = false

    -- THIS puts the buttons inside Settings
    table.insert(tabButtons["settings"], holder)

    guiSizeButtons[btnName] = holder
end

