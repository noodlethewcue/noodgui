local cupcakeOriginal = {}

createButton("clients", "cupcakeling", function(enabled)

    local character = player.Character
    if not character then return end

    local scleraNames = {
        leftsclera = true,
        leftblind = true,
        rightsclera = true,
        rightblind = true
    }

    local pupilNames = {
        leftpupil = true,
        leftpupilblind = true,
        rightpupil = true,
        rightpupilblind = true
    }

    local function isEye(obj)
        local name = obj.Name:lower()
        return scleraNames[name] or pupilNames[name]
    end

    if enabled then

        -- ======================================
        -- MAKE EVERY PART BLACK
        -- EXCEPT THE EYES
        -- ======================================

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                -- Save original appearance
                if not cupcakeOriginal[obj] then
                    cupcakeOriginal[obj] = {
                        Color = obj.Color,
                        Material = obj.Material
                    }
                end

                -- Don't overwrite the eye colours here
                if not isEye(obj) then

                    obj.Color = Color3.fromRGB(0, 0, 0)
                    obj.Material = Enum.Material.SmoothPlastic

                end
            end
        end

        -- ======================================
        -- BLACK SCLERA
        -- ======================================

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                local name = obj.Name:lower()

                if scleraNames[name] then

                    if not cupcakeOriginal[obj] then
                        cupcakeOriginal[obj] = {
                            Color = obj.Color,
                            Material = obj.Material
                        }
                    end

                    obj.Color = Color3.fromRGB(0, 0, 0)
                    obj.Material = Enum.Material.SmoothPlastic

                end
            end
        end

        -- ======================================
        -- RED PUPILS
        -- ======================================

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                local name = obj.Name:lower()

                if pupilNames[name] then

                    if not cupcakeOriginal[obj] then
                        cupcakeOriginal[obj] = {
                            Color = obj.Color,
                            Material = obj.Material
                        }
                    end

obj.Color = Color3.fromRGB(255, 0, 0)
obj.Material = Enum.Material.Neon

                end
            end
        end

    else

        -- ======================================
        -- RESTORE EVERYTHING
        -- ======================================

        for obj, original in pairs(cupcakeOriginal) do

            if obj and obj.Parent then

                obj.Color = original.Color
                obj.Material = original.Material

            end
        end

        table.clear(cupcakeOriginal)
    end
end)
