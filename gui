-- THIS USES YOUR EXACT WORKING METHOD
--==================================================

local function createPresetLabel(roleName)

    local content =
        getContent()

    local backdrop =
        content:WaitForChild("Backdrop")

    -- ==========================================
    -- FIND ROLE
    -- ==========================================

    local role =
        ReplicatedFirst:WaitForChild(roleName)

    -- ==========================================
    -- FIND LABEL
    -- ==========================================

    local originalLabel =
        role:WaitForChild("Label")

    if not originalLabel then

        warn(
            roleName ..
            " > Label not found!"
        )

        return false

    end

    if not originalLabel:IsA("TextLabel") then

        warn(
            roleName ..
            " Label isn't a TextLabel!"
        )

        return false

    end

    -- ==========================================
    -- REMOVE OLD COPY
    -- ==========================================

    local old =
        content:FindFirstChild(
            "Local" ..
            roleName ..
            "Label"
        )

    if old then
        old:Destroy()
    end

    -- ==========================================
    -- COPY LABEL
    -- ==========================================

    local newLabel =
        originalLabel:Clone()

    newLabel.Name =
        "Local" ..
        roleName ..
        "Label"

    -- ==========================================
    -- PUT ABOVE BACKDROP
    -- EXACTLY LIKE YOUR SCRIPT
    -- ==========================================

    newLabel.Parent = content

    newLabel.AnchorPoint =
        Vector2.new(
            backdrop.AnchorPoint.X,
            backdrop.AnchorPoint.Y
        )

    newLabel.Size =
        backdrop.Size

    newLabel.Position =
        UDim2.new(
            backdrop.Position.X.Scale,
            backdrop.Position.X.Offset,
            backdrop.Position.Y.Scale,
            backdrop.Position.Y.Offset
                - backdrop.AbsoluteSize.Y
        )

    newLabel.Visible = true

    newLabel.ZIndex =
        backdrop.ZIndex + 1

    print(
        roleName ..
        " label placed above Backdrop!"
    )

    return true

end

