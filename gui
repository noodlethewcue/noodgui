    if enabled then
        -- save original materials and colors
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                rainbowGhostOriginals[obj] = {
                    Material = obj.Material,
                    Color = obj.Color
                }
                obj.Material = Enum.Material.ForceField
            end
        end

        local hue = 0

        rainbowGhostConnection = RunService.RenderStepped:Connect(function(dt)
            hue = (hue + dt * 0.8) % 1
            local color = Color3.fromHSV(hue, 1, 1)

            for part in pairs(rainbowGhostOriginals) do
                if part and part.Parent then
                    part.Color = color
                end
            end
        end)

    else
        -- stop rainbow loop
        if rainbowGhostConnection then
            rainbowGhostConnection:Disconnect()
            rainbowGhostConnection = nil
        end

        -- restore originals
        for part, data in pairs(rainbowGhostOriginals) do
            if part and part.Parent then
                part.Material = data.Material
                part.Color = data.Color
            end
        end

        rainbowGhostOriginals = {}
    end

end)

