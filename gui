createButton("clients", "rainbow 2", function(enabled)

    -- ======================================
    -- STOP
    -- ======================================

    if not enabled then

        if rainbow2Connection then
            rainbow2Connection:Disconnect()
            rainbow2Connection = nil
        end

        -- Restore original colours
        for obj, colour in pairs(rainbow2Original) do
            if obj and obj.Parent then
                obj.Color = colour
            end
        end

        table.clear(rainbow2Original)

        return
    end

    -- ======================================
    -- STOP PREVIOUS CONNECTION
    -- ======================================

    if rainbow2Connection then
        rainbow2Connection:Disconnect()
        rainbow2Connection = nil
    end

    table.clear(rainbow2Original)

    -- ======================================
    -- FIND YOUR USERNAME FOLDER
    -- ======================================

    local usernameFolder =
        workspace:FindFirstChild(player.Name)

    if not usernameFolder then
        warn("Rainbow 2: username folder not found!")
        return
    end

    -- ======================================
    -- SAVE ORIGINAL COLOURS
    -- ======================================

    local parts = {}

    for _, obj in ipairs(
        usernameFolder:GetDescendants()
    ) do

        if obj:IsA("BasePart") then

            rainbow2Original[obj] = obj.Color
            table.insert(parts, obj)

        end

    end

    -- ======================================
    -- FAST RAINBOW
    -- ======================================

    local hue = 0

    rainbow2Connection =
        game:GetService("RunService").RenderStepped:Connect(
            function(deltaTime)

                hue = (hue + deltaTime * 2.5) % 1

                for i, obj in ipairs(parts) do

                    if obj and obj.Parent then

                        -- Slight offset between parts
                        -- so the whole morph has a rainbow
                        local partHue =
                            (hue + (i / #parts) * 0.25) % 1

                        obj.Color =
                            Color3.fromHSV(
                                partHue,
                                0.75,
                                1
                            )

                    end

                end

            end
        )

end)

