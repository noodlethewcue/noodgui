-- ==========================================
-- CUPCAKELING
-- ==========================================

local cupcakeOriginal = {}

createButton("clients", "cupcakeling", function(enabled)

    local character = player.Character
    if not character then return end

    -- ======================================
    -- EYES
    -- ======================================

    local scleraNames = {
        leftsclera = true,
        leftblind = true,
        rightsclera = true,
        rightblind = true
    }

    local pupilNames = {
        leftpupil = true,
        leftpupilblind = true,
        rightpupil = true,
        rightpupilblind = true
    }

    -- ======================================
    -- PARTS THAT MUST KEEP THEIR COLOUR
    -- ======================================

    local excludedNames = {
        Fang1 = true,
        Jaw2 = true,
        Head2 = true,
        Tongue = true
    }

    local function isExcluded(obj)

        local name = obj.Name

        -- Eyes stay their own colour
        if scleraNames[name:lower()]
        or pupilNames[name:lower()] then
            return true
        end

        -- These stay their original colour
        if excludedNames[name] then
            return true
        end

        return false
    end

    -- ======================================
    -- ENABLE
    -- ======================================

    if enabled then

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                -- Save ORIGINAL colour only
                -- Material is intentionally NOT changed
                if not cupcakeOriginal[obj] then
                    cupcakeOriginal[obj] = {
                        Color = obj.Color
                    }
                end

                -- Everything except excluded parts becomes black
                if not isExcluded(obj) then
                    obj.Color = Color3.fromRGB(0, 0, 0)
                end

            end
        end

        -- ======================================
        -- BLACK SCLERA
        -- ======================================

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                local name = obj.Name:lower()

                if scleraNames[name] then
                    obj.Color = Color3.fromRGB(0, 0, 0)
                end

            end
        end

        -- ======================================
        -- BRIGHT RED PUPILS
        -- ======================================

        for _, obj in ipairs(character:GetDescendants()) do

            if obj:IsA("BasePart") then

                local name = obj.Name:lower()

                if pupilNames[name] then
                    obj.Color = Color3.fromRGB(255, 0, 0)
                end

            end
        end

    -- ======================================
    -- DISABLE
    -- ======================================

    else

        for obj, original in pairs(cupcakeOriginal) do

            if obj and obj.Parent then
                obj.Color = original.Color
            end

        end

        table.clear(cupcakeOriginal)

    end

end)

-- ==========================================
-- CUPCAKELING ALL
-- Makes every player's morph a cupcakeling
-- ==========================================

local cupcakeAllRunning = false
local cupcakeAllConnections = {}

local cupcakeAllOriginalColours = {}
local cupcakeAllOriginalNames = {}

-- ==========================================
-- EYES
-- ==========================================

local cupcakeAllScleraNames = {
    leftsclera = true,
    leftblind = true,
    rightsclera = true,
    rightblind = true
}

local cupcakeAllPupilNames = {
    leftpupil = true,
    leftpupilblind = true,
    rightpupil = true,
    rightpupilblind = true
}

-- ==========================================
-- PARTS THAT KEEP THEIR COLOUR
-- ==========================================

local cupcakeAllExcludedNames = {
    Fang1 = true,
    Jaw2 = true,
    Head2 = true,
    Tongue = true
}

local function cupcakeAllIsExcluded(obj)

    local name = obj.Name

    if cupcakeAllScleraNames[name:lower()]
    or cupcakeAllPupilNames[name:lower()] then
        return true
    end

    if cupcakeAllExcludedNames[name] then
        return true
    end

    return false

end

-- ==========================================
-- FIND MORPH FOLDER
-- ==========================================

local function cupcakeAllGetMorph(playerObject)

    if not playerObject then
        return nil
    end

    -- Everyone's morph is stored directly in Workspace
    -- using their Roblox username.
    return workspace:FindFirstChild(playerObject.Name)

end

-- ==========================================
-- SAVE + CHANGE COLOURS
-- ==========================================

local function cupcakeAllApply(container)

    if not container then
        return
    end

    for _,obj in ipairs(container:GetDescendants()) do

        if obj:IsA("BasePart") then

            -- Save original colour only once
            if cupcakeAllOriginalColours[obj] == nil then
                cupcakeAllOriginalColours[obj] = obj.Color
            end

            local name = obj.Name:lower()

            -- Everything except excluded parts becomes black
            if not cupcakeAllIsExcluded(obj) then
                obj.Color = Color3.fromRGB(0,0,0)
            end

            -- Black sclera
            if cupcakeAllScleraNames[name] then
                obj.Color = Color3.fromRGB(0,0,0)
            end

            -- Bright red pupils
            if cupcakeAllPupilNames[name] then
                obj.Color = Color3.fromRGB(255,0,0)
            end

        end

    end

end

-- ==========================================
-- NAME PATH
-- Billboards > Username > Content >
-- MainContainer > PlayerNameContainer >
-- PlayerName
-- ==========================================

local function cupcakeAllGetNameLabel(playerObject)

    local billboards = workspace:FindFirstChild("Billboards")

    if not billboards then
        return nil
    end

    local playerFolder =
        billboards:FindFirstChild(playerObject.Name)

    if not playerFolder then
        return nil
    end

    local content =
        playerFolder:FindFirstChild("Content")

    if not content then
        return nil
    end

    local mainContainer =
        content:FindFirstChild("MainContainer")

    if not mainContainer then
        return nil
    end

    local playerNameContainer =
        mainContainer:FindFirstChild("PlayerNameContainer")

    if not playerNameContainer then
        return nil
    end

    return playerNameContainer:FindFirstChild("PlayerName")

end

-- ==========================================
-- APPLY JOIN US
-- ==========================================

local function cupcakeAllApplyName(playerObject)

    local label =
        cupcakeAllGetNameLabel(playerObject)

    if not label then
        return
    end

    if cupcakeAllOriginalNames[label] == nil then
        cupcakeAllOriginalNames[label] = label.Text
    end

    label.Text = "JOIN US"

end

-- ==========================================
-- APPLY TO EVERYONE
-- ==========================================

local function cupcakeAllUpdate()

    if not cupcakeAllRunning then
        return
    end

    for _,playerObject in ipairs(Players:GetPlayers()) do

        -- Their morph
        local morph =
            cupcakeAllGetMorph(playerObject)

        if morph then
            cupcakeAllApply(morph)
        end

        -- Their name
        cupcakeAllApplyName(playerObject)

        -- Also apply to their actual character
        -- in case the game uses the character model.
        if playerObject.Character then
            cupcakeAllApply(playerObject.Character)
        end

    end

end

-- ==========================================
-- RESTORE EVERYTHING
-- ==========================================

local function cupcakeAllRestore()

    -- Restore colours
    for obj,originalColour in pairs(cupcakeAllOriginalColours) do

        if obj and obj.Parent then
            obj.Color = originalColour
        end

    end

    table.clear(cupcakeAllOriginalColours)

    -- Restore names
    for label,originalText in pairs(cupcakeAllOriginalNames) do

        if label and label.Parent then
            label.Text = originalText
        end

    end

    table.clear(cupcakeAllOriginalNames)

end

-- ==========================================
-- START
-- ==========================================

local function cupcakeAllStart()

    if cupcakeAllRunning then
        return
    end

    cupcakeAllRunning = true

    -- Apply immediately
    cupcakeAllUpdate()

    -- Keep checking because morphs can appear later
    cupcakeAllConnections.render =
        RunService.RenderStepped:Connect(function()

            cupcakeAllUpdate()

        end)

    -- New players
    cupcakeAllConnections.playerAdded =
        Players.PlayerAdded:Connect(function(newPlayer)

            task.spawn(function()

                -- Wait for their stuff to load
                for i = 1,100 do

                    if not cupcakeAllRunning then
                        return
                    end

                    cupcakeAllUpdate()

                    task.wait(0.1)

                end

            end)

            -- Reapply after character loads
            cupcakeAllConnections["char_" .. newPlayer.Name] =
                newPlayer.CharacterAdded:Connect(function()

                    task.wait(0.5)

                    cupcakeAllUpdate()

                end)

        end)

    -- Existing players' future respawns/morph changes
    for _,playerObject in ipairs(Players:GetPlayers()) do

        cupcakeAllConnections["char_" .. playerObject.Name] =
            playerObject.CharacterAdded:Connect(function()

                task.wait(0.5)

                cupcakeAllUpdate()

            end)

    end

end

-- ==========================================
-- STOP
-- ==========================================

local function cupcakeAllStop()

    cupcakeAllRunning = false

    for _,connection in pairs(cupcakeAllConnections) do

        if connection then
            connection:Disconnect()
        end

    end

    table.clear(cupcakeAllConnections)

    cupcakeAllRestore()

end

-- ==========================================
-- CREATEBUTTON
-- SEPARATE FROM "CUPCAKELING"
-- ==========================================

createButton(
    "clients",
    "cupcakeling all",
    function(enabled)

        if enabled then

            cupcakeAllStart()

        else

            cupcakeAllStop()

        end

    end
)
